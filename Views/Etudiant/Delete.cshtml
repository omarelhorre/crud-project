@model stagiaireCRUD.Models.Etudiant
<style>
    .container
    {
    width: 500px;
    margin: 40px auto;
    padding: 0 20px;
    }
    h1
    {
        margin-top: 24px;
        color: #333;
    }
    
    .btn-row
    {
        display: flex;
        gap: 10px;
        margin-top: 8px;
    }
    .btn-save
    {
        padding: 10px 20px;
        background-color: #0d6efd;
        color: white;
        border: none;
        border-radius: 6px;
        font-size: 14px;
        cursor: pointer;
    }
    .btn-save:hover{
        background-color: #0b5ed7;
    }
    .btn-cancel
    {
        padding: 10px 20px;
        background-color: #e9ecef;
        color: #333;
        border: none;
        border-radius: 6px;
        font-size: 14px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
    }
    .btn-cancel:hover
    {
        background-color: #dee2e6;
    }
</style>

<div class="container">
<h1>Supprimer un Etudiant</h1>
<p>Etes vous sur que vous voulez supprimer <strong>@Model.Nom @Model.prenom ?</strong></p>
<input type="hidden" asp-for="Id"/>
<form method="post">
    <div class="btn-row">
<button type="submit" class="btn-save">confirmer</button>
<a asp-action="Index" class="btn-cancel">Annuler</a>
</div>
</form>
</div>