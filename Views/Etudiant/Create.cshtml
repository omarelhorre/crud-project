@model stagiaireCRUD.Models.Etudiant
<h1>Ajouter un etudiant</h1>
<form method="post">

    <div>
    <label>Nom</label>
    <input asp-for="Nom"/>
    </div>

    <div>
        <label>Prenom</label>
        <input asp-for="prenom"/>
    </div>
    <div>
        <label>Email</label>
        <input asp-for="Email"/>
    </div>

    <div>
        <label>Etablissement</label>
        <input asp-for="Etablissement"/>
    </div>

    <div>
        <label>Date de debut du stage</label>
        <input asp-for="DebutStage"/>
    </div>
    <button type ="submit">Enregistrer </button>
</form>