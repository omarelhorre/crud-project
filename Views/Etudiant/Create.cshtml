@model stagiaireCRUD.Models.Etudiant
<style>
    .container
    {
    width: 500px;
    margin: 40px auto;
    padding: 0 20px;
    }
    h1
    {
        margin-top: 24px;
        color: #333;
    }
    div{
        margin-bottom: 16px;
    }
    label
    {
        display: block;
        margin-bottom: 6px;
        font-weight: 500;
        font-size: 14px;
        color: #555;
    }
    input 
    {
        width: 100%;
        padding: 10px 12px;
        border: 1px solid #ccc;
        border-radius: 6px;
        font-size: 14px;
        box-sizing: border-box;
    }
    .btn-row
    {
        display: flex;
        gap: 10px;
        margin-top: 8px;
    }
    .btn-save
    {
        padding: 10px 20px;
        background-color: #0d6efd;
        color: white;
        border: none;
        border-radius: 6px;
        font-size: 14px;
        cursor: pointer;
    }
    .btn-save:hover{
        background-color: #0b5ed7;
    }
    .btn-cancel
    {
        padding: 10px 20px;
        background-color: #e9ecef;
        color: #333;
        border: none;
        border-radius: 6px;
        font-size: 14px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
    }
    .btn-cancel:hover
    {
        background-color: #dee2e6;
    }
</style>


<div class="container">
    <h1>Ajouter un etudiant</h1>
    <form method="post">

        <div>
        <label>Nom</label>
        <input asp-for="Nom"/>
        </div>

        <div>
            <label>Prenom</label>
            <input asp-for="prenom"/>
        </div>
        <div>
            <label>Email</label>
            <input asp-for="Email"/>
        </div>

        <div>
            <label>Etablissement</label>
            <input asp-for="Etablissement"/>
        </div>

        <div>
            <label>Date de debut du stage</label>
            <input asp-for="DebutStage"/>
        </div>
        <div class="btn-row">
            <button type ="submit" class="btn-save">Enregistrer </button>
            <a asp-action="Index" class="btn-cancel">Annuler</a>
        </div>
    </form>
</div>